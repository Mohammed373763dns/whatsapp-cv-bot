# انسخ هالملف لـ .env وعبّي القيم (على Railway: حطها بـ Variables). ملف .env ما بينرفع ولا بينبعت لحدا.

# مفتاح Grok من https://console.x.ai (بيبلّش بـ xai-) — لفحص السيرة
XAI_API_KEY=
# موديل رخيص وسريع (لقراءة السير المبعوتة كصور)
XAI_MODEL_FAST=

# سقف الصرف اليومي بالدولار — البوت بيوقف الفحص إذا وصله
DAILY_AI_BUDGET_USD=1

# مفتاح البوت لبرنامج الفحص (opti) — نفس القيمة على Vercel بيلغي حد الـ12 بالساعة
OPTI_BOT_KEY=

# كلمة سر الداشبورد — لازمة على Railway (على اللابتوب اختيارية)
DASHBOARD_PASSWORD=
